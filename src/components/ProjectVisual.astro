---
// The picture of a project. With a `cover` screenshot in the project's frontmatter it shows that;
// until then it shows one of the kit's UI fragments (public/assets/ui/<name>), rewritten to the
// stand-in project. Each fragment sits in a .stage at its true size, placed as its meta.json says.
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** card: inside a span-4 card's panel; hero: the big frame on the project's own page. */
  size?: 'card' | 'hero';
  eager?: boolean;
}
const { project, size = 'card', eager = false } = Astro.props;
const { cover, visual } = project.data;
const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p.replace(/^\//, '');
const hero = size === 'hero';
const ay = hero ? '48px' : '32px';
const check = '<svg viewBox="0 0 16 16"><path d="m4.5 8.2 2.3 2.3 4.7-5"/></svg>';
const page = '<svg class="ui-icon" viewBox="0 0 16 16"><path d="M4 2.5h5l3 3v8H4z"/><path d="M9 2.5v3h3"/></svg>';
---
{cover ? (
  <img class="frame__img" src={u(cover.src)} alt={cover.alt} width={cover.width} height={cover.height}
    loading={eager ? 'eager' : 'lazy'} decoding="async" data-source="client" data-subject="project screenshot" />
) : visual === 'calendar' ? (
  <div class="stage stage--fade-b"><div class="at-rise fit" style={`--fit-max:420px;--ax:max(24px, 50% - 210px);--ay:${ay};--ay-sm:16px`}>
    <div class="ui ui-panel ui-calendar" data-ui="calendar" data-start="19" data-end="23" data-month="Oct">
      <div class="ui-cal__head">
        <div class="ui-cal__month">October <span>2026</span></div>
        <span class="ui-spacer"></span>
        <span class="ui-chip ui-chip--plain ui-chip--ink" data-cal-range>Oct 19 – 23</span>
        <span class="ui-cal__nav" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 16 16"><path d="M10 4 6 8l4 4"/></svg></span>
        <span class="ui-cal__nav" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 16 16"><path d="m6 4 4 4-4 4"/></svg></span>
      </div>
      <div class="ui-cal__dow" aria-hidden="true"><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span></div>
      <div class="ui-cal__days">
        <span class="ui-cal__d is-out"><b>28</b></span><span class="ui-cal__d is-out"><b>29</b></span><span class="ui-cal__d is-out"><b>30</b></span><span class="ui-cal__d" data-d="1"><b>1</b></span><span class="ui-cal__d" data-d="2"><b>2</b></span><span class="ui-cal__d" data-d="3"><b>3</b></span><span class="ui-cal__d" data-d="4"><b>4</b></span>
        <span class="ui-cal__d" data-d="5"><b>5</b></span><span class="ui-cal__d" data-d="6"><b>6</b></span><span class="ui-cal__d" data-d="7"><b>7</b></span><span class="ui-cal__d" data-d="8"><b>8</b></span><span class="ui-cal__d" data-d="9"><b>9</b></span><span class="ui-cal__d" data-d="10"><b>10</b></span><span class="ui-cal__d" data-d="11"><b>11</b></span>
        <span class="ui-cal__d" data-d="12"><b>12</b></span><span class="ui-cal__d" data-d="13"><b>13</b></span><span class="ui-cal__d" data-d="14"><b>14</b></span><span class="ui-cal__d" data-d="15"><b>15</b></span><span class="ui-cal__d is-today" data-d="16"><b>16</b></span><span class="ui-cal__d" data-d="17"><b>17</b></span><span class="ui-cal__d" data-d="18"><b>18</b></span>
        <span class="ui-cal__d is-start" data-d="19"><b>19</b></span><span class="ui-cal__d is-in" data-d="20"><b>20</b></span><span class="ui-cal__d is-in" data-d="21"><b>21</b></span><span class="ui-cal__d is-in" data-d="22"><b>22</b></span><span class="ui-cal__d is-end" data-d="23"><b>23</b></span><span class="ui-cal__d" data-d="24"><b>24</b></span><span class="ui-cal__d" data-d="25"><b>25</b></span>
        <span class="ui-cal__d" data-d="26"><b>26</b></span><span class="ui-cal__d" data-d="27"><b>27</b></span><span class="ui-cal__d is-mark" data-d="28"><b>28</b></span><span class="ui-cal__d" data-d="29"><b>29</b></span><span class="ui-cal__d" data-d="30"><b>30</b></span><span class="ui-cal__d" data-d="31"><b>31</b></span><span class="ui-cal__d is-out"><b>1</b></span>
      </div>
      <div class="ui-cal__events">
        <div class="ui-cal__ev" data-ev="19">
          <span class="ui-cal__date"><b>19</b><i>Oct</i></span>
          <span class="ui-cal__evtext"><span class="ui-cal__evtitle">Wheel class, beginners</span><span class="ui-cal__evsub">3 of 8 places left</span></span>
        </div>
        <div class="ui-cal__ev" data-ev="23">
          <span class="ui-cal__date"><b>23</b><i>Oct</i></span>
          <span class="ui-cal__evtext"><span class="ui-cal__evtitle">Glazing evening</span><span class="ui-cal__evsub">Fully booked</span></span>
        </div>
        <div class="ui-cal__ev" data-ev="28">
          <span class="ui-cal__date"><b>28</b><i>Oct</i></span>
          <span class="ui-cal__evtext"><span class="ui-cal__evtitle">Open studio</span><span class="ui-cal__evsub">Drop in from 10:00</span></span>
        </div>
      </div>
    </div>
  </div></div>
) : visual === 'code' ? (
  <div class="stage stage--fade-br"><div class="at-corner" style={`--ax:32px;--ay:${ay};--ay-sm:16px`}>
    <div class="ui ui-panel ui-code" data-ui="code">
      <div class="ui-code__tabs">
        <span class="ui-code__tab is-on"><i class="ui-code__lang">JS</i>search.js</span>
        <span class="ui-code__tab"><i class="ui-code__lang">JS</i>index.js</span>
        <span class="ui-spacer"></span>
        <span class="ui-chip ui-chip--plain ui-code__chip" data-code-chip>1 fix</span>
      </div>
      <pre class="ui-code__pre"><code><span class="ui-code__ln" data-n="12"><span class="k">export function</span> <span class="f">find</span>(query, notes) {"{"}</span>
<span class="ui-code__ln" data-n="13">  <span class="k">const</span> words = <span class="f">split</span>(query);</span>
<span class="ui-code__ln" data-n="14" data-note="Skips an empty box.">  <span class="k">if</span> (!words.length) <span class="k">return</span> [];</span>
<span class="ui-code__ln is-mark" data-n="15">  <span class="k">const</span> hits = notes.<span class="f">filter</span>(n =&gt; <span class="f">has</span>(n, words));</span>
<span class="ui-code__ln" data-n="16">  <span class="c">// headings before body text</span></span>
<span class="ui-code__ln" data-n="17" data-note="Ranks heading matches first.">  hits.<span class="f">sort</span>(byHeading);</span>
<span class="ui-code__ln" data-n="18">  <span class="k">return</span> hits.<span class="f">slice</span>(<span class="n">0</span>, <span class="n">8</span>);</span>
<span class="ui-code__ln" data-n="19">{"}"}</span></code></pre>
      <div class="ui-code__hint" data-code-hint><span class="ui-dot"></span><span data-code-text>Fixed: a heading match now comes first.</span></div>
    </div>
  </div></div>
) : visual === 'stat' ? (
  <div class="stage stage--fade-br"><div class="at-corner" style={`--ax:32px;--ay:${ay};--ay-sm:16px`}>
    <div class="ui ui-panel ui-stat" data-ui="stat" data-from="31" data-to="38">
      <div class="ui-stat__head">
        <div class="ui-stat__top">
          <span class="ui-stat__label">Under-12s, Tuesday session</span>
          <span class="ui-stat__range">Last 14 weeks<svg class="ui-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 6.5 3.5 3.5 3.5-3.5"/></svg></span>
        </div>
        <div class="ui-stat__line">
          <span class="ui-stat__num" data-stat-num>38</span>
          <span class="ui-chip ui-chip--plain ui-stat__delta"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 9.5v-7M3 5.5l3-3 3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>7 players</span>
          <span class="ui-stat__sub">vs. 14 weeks ago</span>
        </div>
      </div>
      <div class="ui-stat__chart">
        <svg class="ui-stat__svg" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
          <path class="ui-stat__grid" d="M0 30.5H400M0 60.5H400M0 90.5H400"/>
          <path class="ui-stat__cover" fill-rule="evenodd" d=""/>
          <g class="ui-stat__bars"><rect rx="3" x="0.00" y="49.04" width="21.14" height="70.96"/><rect rx="3" x="29.14" y="40.86" width="21.14" height="79.14"/><rect rx="3" x="58.29" y="44.95" width="21.14" height="75.05"/><rect rx="3" x="87.43" y="36.76" width="21.14" height="83.24"/><rect rx="3" x="116.57" y="42.22" width="21.14" height="77.78"/><rect rx="3" x="145.71" y="34.04" width="21.14" height="85.96"/><rect rx="3" x="174.86" y="38.13" width="21.14" height="81.87"/><rect rx="3" x="204.00" y="29.94" width="21.14" height="90.06"/><rect rx="3" x="233.14" y="35.40" width="21.14" height="84.60"/><rect rx="3" x="262.29" y="25.85" width="21.14" height="94.15"/><rect rx="3" x="291.43" y="31.31" width="21.14" height="88.69"/><rect rx="3" x="320.57" y="23.12" width="21.14" height="96.88"/><rect rx="3" x="349.71" y="27.21" width="21.14" height="92.79"/><rect rx="3" x="378.86" y="16.30" width="21.14" height="103.70"/></g>
        </svg>
        <div class="ui-stat__axis" aria-hidden="true"><span>Aug 11</span><span>Sep 22</span><span>This week</span></div>
      </div>
    </div>
  </div></div>
) : visual === 'checklist' ? (
  <div class="stage stage--fade-b"><div class="at-rise fit" style={`--fit-max:360px;--ax:max(24px, 50% - 180px);--ay:${hero ? '64px' : '40px'};--ay-sm:16px`}>
    <div class="ui ui-panel ui-checks" data-ui="checklist">
      <div class="ui-checks__head">
        <div class="ui-title">Your first newsletter</div>
        <span class="ui-spacer"></span>
        <div class="ui-meta" data-checks-count>3 of 5</div>
      </div>
      <div class="ui-checks__bar"><i data-checks-bar style="--k:0.6"></i></div>
      <ul class="ui-checks__list">
        <li class="ui-check is-done"><span class="ui-check__box" set:html={check} /><span class="ui-check__label">Name your newsletter</span></li>
        <li class="ui-check is-done"><span class="ui-check__box" set:html={check} /><span class="ui-check__label">Import 240 subscribers</span></li>
        <li class="ui-check is-done"><span class="ui-check__box" set:html={check} /><span class="ui-check__label">Write the welcome email</span></li>
        <li class="ui-check"><span class="ui-check__box" set:html={check} /><span class="ui-check__label">Send a test to yourself</span></li>
        <li class="ui-check"><span class="ui-check__box" set:html={check} /><span class="ui-check__label">Schedule for Friday 8:00</span></li>
      </ul>
    </div>
  </div></div>
) : visual === 'search' ? (
  <div class="stage stage--fade-b"><div class="at-rise fit" style={`--fit-max:380px;--ax:max(24px, 50% - 190px);--ay:${hero ? '64px' : '40px'};--ay-sm:16px`}>
    <div class="ui ui-panel ui-search" data-ui="search">
      <div class="ui-search__field">
        <svg class="ui-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3 3"/></svg>
        <span class="ui-search__q"><span data-search-q>linen shrt</span><i class="ui-search__caret"></i></span>
        <kbd class="ui-search__kbd">Ctrl K</kbd>
      </div>
      <div class="ui-search__group">Products</div>
      <ul class="ui-search__list" data-search-list>
        <li class="ui-search__row is-sel"><span class="ui-search__ico" set:html={page} /><span class="ui-search__t"><b>Linen shirt</b>, sand</span><span class="ui-search__m">Shirts</span></li>
        <li class="ui-search__row"><span class="ui-search__ico" set:html={page} /><span class="ui-search__t"><b>Linen shirt</b>, short sleeve</span><span class="ui-search__m">Shirts</span></li>
        <li class="ui-search__row"><span class="ui-search__ico" set:html={page} /><span class="ui-search__t"><b>Linen</b> trousers, wide leg</span><span class="ui-search__m">Trousers</span></li>
      </ul>
      <div class="ui-search__foot"><span><kbd>&uarr;</kbd><kbd>&darr;</kbd> to move</span><span><kbd>Enter</kbd> to open</span></div>
    </div>
  </div></div>
) : (
  <div class="stage stage--fade-b"><div class="at-rise fit" style={`--fit-max:380px;--ax:32px;--ay:calc(100% - ${hero ? '240px' : '180px'});--ay-sm:calc(100% - 180px)`}>
    <div class="ui ui-notify" data-ui="notify">
      <ul class="ui-notify__list" data-notify-list>
        <li class="ui-note"><span class="ui-agent ui-note__av" aria-hidden="true"></span><span class="ui-note__text"><span class="ui-note__title">New order, pickup 10:30<time>now</time></span><span class="ui-note__body">2 rye loaves, 6 buns, paid online</span></span><span class="ui-btn ui-btn--sm ui-note__btn">Open</span></li>
        <li class="ui-note"><span class="ui-avatar ui-note__av" data-tone="3">MK</span><span class="ui-note__text"><span class="ui-note__title">Order 212 collected<time>6m</time></span><span class="ui-note__body">Marked by the stall's second phone</span></span></li>
        <li class="ui-note"><span class="ui-note__ico"><svg class="ui-icon" viewBox="0 0 16 16"><path d="m3.5 8.4 2.8 2.8 6.2-6.4"/></svg></span><span class="ui-note__text"><span class="ui-note__title">31 orders this Saturday<time>1h</time></span><span class="ui-note__body">All packed before 9:00</span></span></li>
      </ul>
    </div>
  </div></div>
)}
