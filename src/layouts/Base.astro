---
// The page shell, built from the taste-skill starter (public/assets/starter.html).
// type: service · deal: hero split, nav-centre, close-type, footer-dark, rhythm dark-band,
// buttons arrow, mark ring, palette stone-blueprint, type rethink, radius soft.
import { getCollection } from 'astro:content';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** The home page links its own sections as "#id"; inner pages link back to "/#id". */
  home?: boolean;
  /** Fragment stylesheets the page uses (public/assets/ui/<name>/fragment.css). */
  fragments?: string[];
  /** The moment dealt onto this page, if any (public/assets/moments/<id>). */
  moment?: string;
}

const { title, description, home = false, fragments = [], moment } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p.replace(/^\//, '');
const to = (id: string) => (home ? `#${id}` : `${base}#${id}`);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const mail = `mailto:${site.email}`;
---
<!doctype html>
<html lang="en" data-type="service" data-radius="soft" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={u('share.jpg')}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={u('favicon.svg')} type="image/svg+xml">
<meta name="theme-color" content="#dfdedb">
<!-- <link rel="canonical" href="https://[your domain]/"> once the site has its own domain -->
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400..700&family=Libre+Franklin:wght@400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href={u('assets/system.css')}>
<link rel="stylesheet" href={u('assets/ui/cards.css')}>
<link rel="stylesheet" href={u('assets/motion/motion.css')}>
<link rel="stylesheet" href={u('assets/backgrounds/backgrounds.css')}>
<link rel="stylesheet" href={u('assets/layout/layout.css')}>
<link rel="stylesheet" href={u('assets/icons/icon.css')}>
<style is:inline>
:root {
  --p-bg: #dfdedb; --p-surface: #d3d2ce; --p-ink: #26251e; --p-muted: #5a5850;
  --p-accent: #2456d6; --p-accent-ink: #ffffff; --p-action: #2456d6; --p-action-ink: #ffffff;
  --p-inv-bg: #26251e; --p-inv-surface: #313029; --p-inv-ink: #dfdedb; --p-inv-muted: #9e9d99;
  --p-inv-accent: #dfdedb; --p-inv-accent-ink: #26251e; --p-inv-action: #dfdedb; --p-inv-action-ink: #26251e;
  --font-display: "Source Serif 4", Georgia, serif;
  --font-text: "Libre Franklin", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.02em;
  --display-tracking-xl: -0.026em;
}
</style>
{fragments.length > 0 && <link rel="stylesheet" href={u('assets/ui/base.css')}>}
{fragments.map((f) => <link rel="stylesheet" href={u(`assets/ui/${f}/fragment.css`)}>)}
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline src={u('assets/backgrounds/backgrounds.js')}></script>
{moment && <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>}
{moment && <link rel="modulepreload" href={u('assets/moments/moments.js')}>}
{moment && <link rel="modulepreload" href={u('assets/moments/lib.js')}>}
{moment && <link rel="modulepreload" href={u(`assets/moments/${moment}/moment.js`)}>}
<slot name="head" />
</head>
<body>

<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href={home ? '#top' : base}><span class="mark" data-mark="ring" aria-hidden="true"></span>{site.name}</a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item"><a class="nav__link" href={to('about')}>About</a></div>
      <div class="nav__item"><a class="nav__link" href={to('skills')}>Skills</a></div>
      <div class="nav__item"><a class="nav__link" href={to('experience')}>Experience</a></div>
      <div class="nav__item">
        <a class="nav__link" href={to('projects')}>Projects <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-4">
              <p class="t-label">Projects</p>
              {projects.slice(0, 3).map((p) => (
                <a href={u(`projects/${p.id}/`)}>{p.data.title}<span>{p.data.stack.slice(0, 2).join(', ')}</span></a>
              ))}
            </div>
            <div class="menu-col span-4">
              <p class="t-label">More projects</p>
              {projects.slice(3, 6).map((p) => (
                <a href={u(`projects/${p.id}/`)}>{p.data.title}<span>{p.data.stack.slice(0, 2).join(', ')}</span></a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={mail}>Email me</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer class="footer closing footer--dark ground-inverse" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">Write to me about a project or role</h2>
        <p>Freelance builds and full-time roles are both welcome.</p>
      </div>
      <a class="btn btn--primary btn--xl" href={mail}>Email me<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo footer__name" href={home ? '#top' : base}><span class="mark" data-mark="ring" aria-hidden="true"></span>{site.name}</a>
          <p class="footer__lede">{site.footerLine}</p>
        </div>
        <div class="span-2 start-9 footer__col"><h3>Pages</h3><ul>
          <li><a href={to('about')}>About</a></li>
          <li><a href={to('skills')}>Skills</a></li>
          <li><a href={to('experience')}>Experience</a></li>
          <li><a href={to('projects')}>Projects</a></li>
        </ul></div>
        <div class="span-2 footer__col"><h3>Elsewhere</h3><ul>
          {site.links.github && <li><a href={site.links.github}>GitHub</a></li>}
          {site.links.linkedin && <li><a href={site.links.linkedin}>LinkedIn</a></li>}
          <li><a href={mail}>Email</a></li>
        </ul></div>
      </div>
      <div class="footer__legal">
        <span>&copy; {year} {site.name}</span>
        <div class="socials"></div>
        <a class="credits" href={u('credits.html')}>Photographs via Wikimedia Commons. Product names and logos are trademarks of their owners</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline type="module" src={u('assets/system.js')}></script>
<script is:inline type="module" src={u('assets/motion/motion.js')}></script>
<script is:inline type="module" src={u('assets/layout/layout.js')}></script>
</body>
</html>
